PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (see Day 1 setup steps)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/eventhub?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# QR token signing (can reuse JWT_SECRET or use a separate one)
QR_SECRET=replace_with_another_long_random_string

# Frontend origin (for CORS + Socket.io)
CLIENT_URL=http://localhost:5173
